# App (required)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Sheets – MVP data source (required for server-side reads/writes)
# Service account must have Editor access to the spreadsheet.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id

# Przelewy24 (optional until payment section)
P24_MERCHANT_ID=
P24_POS_ID=
P24_API_KEY=
P24_CRC_KEY=
P24_API_BASE_URL=https://secure.przelewy24.pl

# Email (optional until email section)
RESEND_API_KEY=
MAIL_FROM=tickets@example.com
INVOICE_NOTIFICATION_EMAIL=admin@example.com

# Supabase — connect to your existing project
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Server-only — Dashboard → Project Settings → API → service_role
# Never commit real values or expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Admin panel password (required for /admin)
ADMIN_PASSWORD=change-me
